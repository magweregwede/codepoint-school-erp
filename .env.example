# Copy to .env.local and fill in.
# Get a free Postgres database at https://neon.tech (recommended) or any other Postgres host.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Generate with: openssl rand -base64 32  (or any random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Local dev only — leave true for any non-Vercel deployment behind a proxy
AUTH_TRUST_HOST="true"

# Override only if not running on the default port
NEXTAUTH_URL="http://localhost:3000"
